const Rs = n => 'Rs. ' + n.toLocaleString('en-PK');

function renderProducts() {
  const tbody = document.getElementById('productsTable');
  tbody.innerHTML = products.map(p => `
    <tr>
      <td><div style="width:44px;height:44px;background:#f0f0f0;border-radius:6px;border:1px solid #eee;display:flex;align-items:center;justify-content:center;font-size:18px">🖼</div></td>
