      <td>
        <div class="td-price">${Rs(p.price)}</div>
        ${p.was ? `<div class="td-was">${Rs(p.was)}</div>` : ''}
      </td>
      <td>
        ${p.status === 'sale' ? '<span class="badge-tag tag-sale">Sale</span>' : '<span class="badge-tag tag-active">Active</span>'}
        ${p.badges.includes('n') ? ' <span class="badge-tag tag-new">New</span>' : ''}
