}
.act-edit{background:#f5f5f5;color:#555}
.act-edit:hover{background:#eee;color:#111}
.act-del{background:#fef2f2;color:#dc2626}
.act-del:hover{background:#fee2e2}

/* ── COLOR PICKER ── */
.color-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:8px}
.color-swatch{
  width:32px;height:32px;border-radius:50%;cursor:pointer;
  border:3px solid transparent;transition:all .18s;
  position:relative;
}
.color-swatch.selected{border-color:#111;transform:scale(1.15)}
.color-swatch:hover{transform:scale(1.1)}

/* ── IMAGE UPLOAD ── */
.img-upload{
  border:2px dashed #e0e0e0;border-radius:8px;
  padding:28px;text-align:center;cursor:pointer;
  transition:border-color .18s,background .18s;
  position:relative;
}
.img-upload:hover{border-color:#aaa;background:#fafafa}
.img-upload input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
