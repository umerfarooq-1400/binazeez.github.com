.sb-bottom{padding:16px 20px;border-top:1px solid #1e1e1e}
.sb-user{display:flex;align-items:center;gap:10px}
.sb-avatar{width:34px;height:34px;border-radius:50%;background:#333;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600;flex-shrink:0}
.sb-user-name{font-size:12.5px;font-weight:600;color:#fff}
.sb-user-role{font-size:10px;color:#444;margin-top:1px}

/* ── MAIN ── */
.main{margin-left:240px;flex:1;min-height:100vh;display:flex;flex-direction:column}

/* TOP BAR */
.topbar{
