  {id:17,n:'Islamic Calligraphy Art',c:'Wall Decor',p:1049,w:1800,r:5,rv:91,img:'data:image/png;base64,',b:['hot'],s:'wall'},
  {id:18,n:'Canvas Scenery Print',c:'Wall Decor',p:2200,w:3500,r:4,rv:33,img:'data:image/png;base64,',b:['sale'],s:'wall'},
  {id:19,n:'Deer Wall Clock',c:'Wall Decor',p:16699,w:22600,r:5,rv:17,img:'data:image/png;base64,',b:['n'],s:'wall'},
  {id:20,n:'Golden Sunburst Mirror',c:'Wall Decor',p:4500,w:7000,r:5,rv:44,img:'data:image/png;base64,',b:['hot','sale'],s:'wall'},
  {id:21,n:'Macrame Wall Hanging',c:'Wall Decor',p:1800,w:2800,r:4,rv:62,img:'data:image/png;base64,',b:['sale'],s:'wall'},
  {id:22,n:'3D Geometric Wall Panel',c:'Wall Decor',p:3200,w:5000,r:5,rv:28,img:'data:image/png;base64,',b:['n'],s:'wall'},
];

const Rs=n=>'Rs. '+n.toLocaleString('en-PK');
const pct=(w,p)=>Math.round((w-p)/w*100);
const st=n=>'★'.repeat(n)+'☆'.repeat(5-n);
const BL={sale:'b-sale',n:'b-new',hot:'b-hot'};
const BT=(b,w,p)=>({sale:`-${pct(w,p)}%`,n:'New',hot:'Hot'}[b]);

function card(p){
  const bs=p.b.map(b=>`<span class="badge ${BL[b]}">${BT(b,p.w,p.p)}</span>`).join('');
  const was=p.w?`<span class="p-was">${Rs(p.w)}</span><span class="p-off">-${pct(p.w,p.p)}%</span>`:'';
  return `<div class="pc">
    <div class="pc-img">
      <img src="${p.img}" alt="${p.n}" loading="lazy">
      <div class="pc-badges">${bs}</div>
      <button class="pc-wish" aria-label="Wishlist"><svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></button>
      <div class="pc-atc-wrap"><button class="pc-atc" data-id="${p.id}">Add to Cart</button></div>
    </div>
    <div class="pc-body">
      <div class="pc-cat">${p.c}</div>
      <div class="pc-name">${p.n}</div>
      <div class="pc-stars">${st(p.r)} <span>(${p.rv})</span></div>
      <div class="pc-price"><span class="p-now">${Rs(p.p)}</span>${was}</div>
    </div>
  </div>`;
}

document.getElementById('rowNew').innerHTML=D.filter(x=>x.s==='new').map(card).join('');
document.getElementById('rowBest').innerHTML=D.filter(x=>x.s==='best').map(card).join('');
document.getElementById('gridFeat').innerHTML=D.filter(x=>x.s==='feat').map(card).join('');
document.getElementById('rowWall').innerHTML=D.filter(x=>x.s==='wall').map(card).join('');

let cart=0;
document.addEventListener('click',e=>{
  const b=e.target.closest('.pc-atc');if(!b)return;
  cart++;document.getElementById('cartCount').textContent=cart;
  const o=b.textContent;b.textContent='Added';b.style.background='#2e6e42';
  setTimeout(()=>{b.textContent=o;b.style.background='';},1500);
});

const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target);}}),{threshold:.05});
document.querySelectorAll('.r').forEach(el=>io.observe(el));

window.addEventListener('scroll',()=>{document.getElementById('navbar').style.boxShadow=scrollY>6?'0 2px 20px rgba(0,0,0,.07)':'0 1px 0 #ebebeb';},{passive:true});

document.getElementById('nlBtn').addEventListener('click',function(){
  const v=document.getElementById('nlInput').value.trim();
  if(v.includes('@')){this.textContent='Subscribed!';this.style.background='#2e6e42';this.style.color='#fff';document.getElementById('nlInput').value='';}
  else{document.getElementById('nlInput').style.outline='2px solid #b83030';setTimeout(()=>document.getElementById('nlInput').style.outline='',1400);}
});
</script>
