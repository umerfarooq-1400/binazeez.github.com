        <div class="td-actions">
          <button class="act-btn act-edit" onclick="editProduct(${p.id})">Edit</button>
          <button class="act-btn act-del" onclick="deleteProduct(${p.id})">Delete</button>
        </div>
      </td>
    </tr>
  `).join('');
}

// ── Page Navigation ──
function showPage(id, el) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.sb-item').forEach(i => i.classList.remove('active'));
  document.getElementById('page-' + id).classList.add('active');
  if(el) el.classList.add('active');
  const titles = {
    dashboard: ['Dashboard', 'Welcome back, Umer'],
    products:  ['Products', 'Manage your catalog'],
    orders:    ['Orders', 'View and manage orders'],
    customers: ['Customers', 'Customer database'],
    homepage:  ['Homepage Editor', 'Edit every section'],
    navbar:    ['Navbar & Menu', 'Edit navigation'],
    branding:  ['Branding & Colors', 'Customize your look'],
    promo:     ['Promo & Sale', 'Manage promotions'],
    settings:  ['Settings', 'Store configuration'],
  };
  const t = titles[id] || [id, ''];
  document.getElementById('pageTitle').textContent = t[0];
  document.getElementById('pageSub').textContent = t[1];
}

// ── Modal ──
function showModal(id) {
  document.getElementById('modal-'+id).classList.add('open');
}
function closeModal(id) {
  document.getElementById('modal-'+id).classList.remove('open');
}
document.querySelectorAll('.modal-bg').forEach(bg => {
  bg.addEventListener('click', e => { if(e.target === bg) bg.classList.remove('open'); });
});

// ── Toast ──
function toast(msg, type='success') {
  const t = document.getElementById('toast');
  const m = document.getElementById('toastMsg');
  m.textContent = msg;
  t.className = 'toast ' + type;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// ── Save ──
function saveSection(name) {
  toast(name + ' saved successfully!', 'success');
}

// ── Product Actions ──
function editProduct(id) {
  toast('Edit product #' + id + ' — coming soon!');
}
function deleteProduct(id) {
  if(confirm('Delete this product?')) {
    const idx = products.findIndex(p => p.id === id);
    if(idx > -1) { products.splice(idx,1); renderProducts(); toast('Product deleted','error'); }
  }
}
function addProduct() {
  toast('Product added to catalog!', 'success');
  closeModal('addProduct');
}

// ── Image Preview ──
function previewHero(input) {
  const preview = document.getElementById('heroPreview');
  preview.innerHTML = '';
  if(input.files[0]) {
    const img = document.createElement('img');
    img.src = URL.createObjectURL(input.files[0]);
    img.className = 'img-thumb';
    preview.appendChild(img);
    toast('Hero image uploaded!');
  }
}
function previewModal(input) {
  const preview = document.getElementById('modalPreview');
  preview.innerHTML = '';
  if(input.files[0]) {
    const img = document.createElement('img');
    img.src = URL.createObjectURL(input.files[0]);
    img.style.cssText = 'width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid #eee';
    preview.appendChild(img);
  }
}

// ── Color Picker ──
function selectColor(el) {
  document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
  el.classList.add('selected');
  toast('Color preset selected!');
}

// ── Promo Preview ──
function updatePromoPreview() {
  document.getElementById('promoPreview').textContent = document.getElementById('promoText').value;
}
function togglePromo() {
  const on = document.getElementById('promoToggle').checked;
  toast('Announcement bar ' + (on ? 'enabled' : 'disabled'));
}

// ── Init ──
renderProducts();
</script>
