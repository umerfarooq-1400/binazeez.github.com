<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cozy Home — Home Decor Pakistan</title>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
/* RESET */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'Outfit', sans-serif; color: #1c1c1c; background: #fff; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
a { text-decoration: none; color: inherit; }
ul { list-style: none; }
button { cursor: pointer; border: none; background: none; font-family: inherit; }
input { font-family: inherit; }

/* DO NOT set global img height — let each context control it */
img { display: block; }

:root {
  --ink: #111;
  --body: #4a4a4a;
  --muted: #8a8a8a;
  --pale: #c4c4c4;
  --rule: #ebebeb;
  --surface: #f6f6f4;
  --white: #fff;
  --danger: #b83030;
  --serif: 'EB Garamond', Georgia, serif;
  --sans: 'Outfit', sans-serif;
  --ease: cubic-bezier(.22,1,.36,1);
}

/* ── NAVBAR ── */
.navbar {
  position: sticky; top: 0; z-index: 900;
  background: #fff;
  border-bottom: 1px solid var(--rule);
  box-shadow: 0 1px 0 var(--rule);
}
.nav-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 48px; height: 76px; gap: 20px;
}
.nav-logo {
  grid-column: 2;
  display: flex; flex-direction: column; align-items: center; gap: 3px;
}
.nav-logo-img {
  width: 48px; height: 48px;
  object-fit: contain;
  display: block;
  flex-shrink: 0;
}
.nav-logo-text {
  font-family: var(--serif); font-size: 18px; font-weight: 500;
  color: var(--ink); letter-spacing: 3px; text-transform: uppercase; line-height: 1;
}
.nav-logo-text em { font-style: normal; font-weight: 300; }
.nav-left { grid-column: 1; display: flex; align-items: center; }
.nav-search {
  display: flex; align-items: center;
  border: 1px solid var(--rule); background: var(--surface);
  width: 100%; max-width: 320px;
  transition: border-color .2s;
}
.nav-search:focus-within { border-color: var(--ink); background: #fff; }
.nav-search input {
  flex: 1; padding: 9px 14px; border: none; outline: none;
  font-size: 13px; background: transparent; color: var(--ink);
}
.nav-search input::placeholder { color: var(--pale); }
.nav-search-btn {
  width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
  color: var(--muted); transition: color .2s; flex-shrink: 0;
}
.nav-search-btn:hover { color: var(--ink); }
.nav-search-btn svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; }
.nav-right { grid-column: 3; display: flex; align-items: center; justify-content: flex-end; gap: 4px; }
.nav-icon {
  width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
  color: var(--ink); border-radius: 4px; transition: background .2s; position: relative;
}
.nav-icon:hover { background: var(--surface); }
.nav-icon svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
.nav-badge {
  position: absolute; top: 5px; right: 5px;
  background: var(--danger); color: #fff;
  min-width: 15px; height: 15px; border-radius: 8px; padding: 0 3px;
  font-size: 9px; font-weight: 700;
  display: flex; align-items: center; justify-content: center; line-height: 1;
}

/* CATEGORY BAR */
.catbar {
  border-top: 1px solid var(--rule);
  display: flex; align-items: stretch; justify-content: center;
  padding: 0 48px;
}
.cm { position: relative; }
.cm > a, .cm > button {
  display: flex; align-items: center; gap: 4px;
  padding: 11px 16px;
  font-size: 11.5px; letter-spacing: 1.2px; text-transform: uppercase;
  font-weight: 500; color: var(--muted);
  background: none; border: none; white-space: nowrap;
  border-bottom: 2px solid transparent;
  transition: color .18s, border-color .18s;
}
.cm:hover > a, .cm:hover > button { color: var(--ink); border-bottom-color: var(--ink); }
.cm.hi > a, .cm.hi > button { color: var(--danger); }
.cm.hi:hover > a, .cm.hi:hover > button { border-bottom-color: var(--danger); }
.cm.fresh > a, .cm.fresh > button { color: #2e6e42; }
.cm.fresh:hover > a, .cm.fresh:hover > button { border-bottom-color: #2e6e42; }
.caret { font-size: 7px; opacity: .35; }

/* DROPDOWNS */
.dd, .mdd {
  position: absolute; top: 100%; left: 50%;
  background: #fff; border: 1px solid var(--rule);
  border-top: 2px solid var(--ink);
  box-shadow: 0 16px 48px rgba(0,0,0,.1);
  z-index: 800;
  opacity: 0; visibility: hidden; pointer-events: none;
  transform: translateX(-50%) translateY(8px);
  transition: opacity .18s, transform .18s, visibility .18s;
}
.cm:hover .dd, .cm:hover .mdd {
  opacity: 1; visibility: visible; pointer-events: all;
  transform: translateX(-50%) translateY(0);
}
.dd { min-width: 190px; }
.dd a {
  display: block; padding: 10px 22px;
  font-size: 13px; color: var(--body);
  border-bottom: 1px solid var(--surface);
  transition: all .14s; letter-spacing: .1px;
}
.dd a:last-child { border: none; }
.dd a:hover { color: var(--ink); background: var(--surface); padding-left: 28px; }
.mdd {
  width: 540px; padding: 28px 32px;
  display: grid; grid-template-columns: repeat(3,1fr); gap: 24px;
  left: 0; transform: translateY(8px);
}
.cm:hover .mdd { transform: translateY(0); }
.mc h6 {
  font-size: 9px; letter-spacing: 3px; text-transform: uppercase;
  font-weight: 600; color: var(--ink);
  margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--rule);
}
.mc a { display: block; font-size: 13px; color: var(--body); padding: 4px 0; transition: color .14s; }
.mc a:hover { color: var(--ink); }

/* ── HERO ── */
.hero {
  display: grid;
  grid-template-columns: 58% 42%;
  height: 88vh;
  min-height: 500px;
  max-height: 800px;
}
.hero-img {
  position: relative;
  overflow: hidden;
  background: #1a1a1a;
  min-height: 500px;
}
.hero-img img {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center top;
}
.hero-img-tag {
  position: absolute; bottom: 32px; left: 32px; z-index: 2;
  background: rgba(255,255,255,.96);
  padding: 14px 20px; backdrop-filter: blur(8px);
}
.hit-label { font-size: 9px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--muted); }
.hit-val { font-family: var(--serif); font-size: 26px; font-weight: 500; color: var(--danger); line-height: 1; }
.hero-panel {
  background: var(--surface);
  display: flex; flex-direction: column; justify-content: center;
  padding: 60px 52px;
}
.hero-eyebrow {
  font-size: 10px; letter-spacing: 5px; text-transform: uppercase;
  color: var(--pale); font-weight: 500; margin-bottom: 20px;
}
.hero-h {
  font-family: var(--serif);
  font-size: clamp(40px, 4.5vw, 68px);
  font-weight: 400; line-height: 1.08;
  color: var(--ink); margin-bottom: 18px;
}
.hero-h em { font-style: italic; color: var(--muted); }
.hero-sub {
  font-size: 14px; line-height: 1.8; color: var(--muted);
  max-width: 360px; margin-bottom: 36px; font-weight: 300;
}
.hero-btns { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; margin-bottom: 44px; }
.btn-dark {
  display: inline-block;
  background: var(--ink); color: #fff;
  padding: 12px 36px;
  font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 600;
  transition: background .2s;
}
.btn-dark:hover { background: #333; }
.btn-bare {
  font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--muted); font-weight: 500;
  border-bottom: 1px solid var(--rule); padding-bottom: 2px;
  transition: color .2s, border-color .2s; display: inline-block;
}
.btn-bare:hover { color: var(--ink); border-color: var(--pale); }
.hero-nums {
  display: grid; grid-template-columns: repeat(3,1fr);
  padding-top: 28px; border-top: 1px solid var(--rule);
}
.hn { padding-right: 16px; border-right: 1px solid var(--rule); }
.hn:last-child { border: none; padding-left: 16px; padding-right: 0; }
.hn:nth-child(2) { padding: 0 16px; }
.hn-n { font-family: var(--serif); font-size: 28px; font-weight: 400; color: var(--ink); line-height: 1; }
.hn-l { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--pale); margin-top: 4px; }

/* ── TRUST BAND ── */
.trust {
  display: grid; grid-template-columns: repeat(4,1fr);
  border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
  background: var(--surface);
}
.tb {
  display: flex; align-items: center; gap: 14px;
  padding: 20px 24px; border-right: 1px solid var(--rule);
  transition: background .2s;
}
.tb:last-child { border: none; }
.tb:hover { background: #fff; }
.tb svg { width: 22px; height: 22px; stroke: var(--ink); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
.tb-title { font-size: 12.5px; font-weight: 600; color: var(--ink); margin-bottom: 2px; }
.tb-sub { font-size: 11px; color: var(--muted); }

/* ── TICKER ── */
.ticker { overflow: hidden; background: var(--surface); border-bottom: 1px solid var(--rule); padding: 10px 0; }
.ticker-t { display: flex; white-space: nowrap; animation: run 22s linear infinite; width: max-content; }
.ticker-t:hover { animation-play-state: paused; }
@keyframes run { to { transform: translateX(-50%); } }
.ti {
  display: inline-flex; align-items: center; gap: 40px;
  padding: 0 40px; font-size: 10px; letter-spacing: 3px;
  text-transform: uppercase; color: var(--pale);
}
.ti::after { content: '·'; font-size: 18px; color: var(--rule); }

/* ── SECTION ── */
.sec { padding: 68px 48px; }
.sec-white { background: #fff; }
.sec-surface { background: var(--surface); }
.sec-hd { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 40px; }
.eyebrow { font-size: 9.5px; letter-spacing: 4px; text-transform: uppercase; color: var(--pale); font-weight: 500; margin-bottom: 8px; }
.sec-title { font-family: var(--serif); font-size: clamp(26px, 2.5vw, 38px); font-weight: 400; color: var(--ink); line-height: 1.15; }
.sec-title em { font-style: italic; color: var(--muted); }
.btn-ghost {
  font-size: 11px; letter-spacing: 1.8px; text-transform: uppercase;
  font-weight: 500; color: var(--muted);
  padding: 9px 20px; border: 1px solid var(--rule);
  transition: all .2s; white-space: nowrap;
}
.btn-ghost:hover { border-color: var(--ink); color: var(--ink); }

/* ROW SECTION */
.rs { padding: 48px 48px; border-bottom: 1px solid var(--rule); }
.rs-surface { background: var(--surface); }
.rs-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; padding-bottom: 14px; border-bottom: 1px solid var(--rule); }
.rs-hd h3 { font-family: var(--serif); font-size: 22px; font-weight: 400; color: var(--ink); }
.scroller { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
.scroller::-webkit-scrollbar { display: none; }

/* ── CATEGORY TILES ── */
.cat-row { display: grid; grid-template-columns: repeat(5,1fr); gap: 8px; }
.ct { position: relative; overflow: hidden; cursor: pointer; background: #c8c0b8; }
.ct img {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform .7s var(--ease);
}
.ct:hover img { transform: scale(1.05); }
.ct-ov {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.72) 0%, transparent 55%);
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 16px; transition: background .3s;
}
.ct:hover .ct-ov { background: linear-gradient(to top, rgba(0,0,0,.82) 0%, rgba(0,0,0,.04) 65%); }
.ct-n { font-family: var(--serif); font-size: 18px; font-weight: 400; color: #fff; margin-bottom: 2px; }
.ct-c { font-size: 10px; color: rgba(255,255,255,.45); }
.ct-arrow { font-size: 9.5px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,.25); margin-top: 7px; transition: color .22s, gap .22s; display: flex; align-items: center; gap: 4px; }
.ct:hover .ct-arrow { color: rgba(255,255,255,.85); gap: 8px; }

/* ── PRODUCT CARD ── */
.product-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }
.scroller .pc { min-width: 210px; max-width: 210px; flex-shrink: 0; }

.pc { background: #fff; cursor: pointer; border: 1px solid var(--rule); transition: box-shadow .25s, border-color .25s; }
.pc:hover { box-shadow: 0 6px 28px rgba(0,0,0,.08); border-color: #d8d8d8; }
.pc-img { position: relative; overflow: hidden; background: var(--surface); }
.pc-img img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition: transform .6s var(--ease);
}
.pc:hover .pc-img img { transform: scale(1.05); }
.pc-badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 4px; z-index: 2; }
.badge { font-size: 9px; letter-spacing: 1px; text-transform: uppercase; font-weight: 700; padding: 3px 9px; line-height: 1.6; }
.b-sale { background: var(--danger); color: #fff; }
.b-new { background: var(--ink); color: #fff; }
.b-hot { background: #9a5a10; color: #fff; }
.pc-wish {
  position: absolute; top: 10px; right: 10px; z-index: 2;
  width: 30px; height: 30px; border-radius: 50%; background: #fff;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,.1);
  opacity: 0; transition: opacity .18s;
}
.pc-wish svg { width: 14px; height: 14px; stroke: #777; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: stroke .2s; }
.pc:hover .pc-wish { opacity: 1; }
.pc-wish:hover { background: var(--danger); }
.pc-wish:hover svg { stroke: #fff; }
.pc-atc-wrap { position: absolute; bottom: 0; left: 0; right: 0; transform: translateY(100%); transition: transform .25s var(--ease); }
.pc:hover .pc-atc-wrap { transform: translateY(0); }
.pc-atc { width: 100%; padding: 11px; background: rgba(17,17,17,.92); color: #fff; border: none; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; font-weight: 600; cursor: pointer; font-family: var(--sans); transition: background .18s; }
.pc-atc:hover { background: var(--ink); }
.pc-body { padding: 12px 14px 16px; }
.pc-cat { font-size: 9.5px; letter-spacing: 2px; text-transform: uppercase; color: var(--pale); margin-bottom: 4px; font-weight: 500; }
.pc-name { font-family: var(--serif); font-size: 15px; font-weight: 400; color: var(--ink); margin-bottom: 6px; line-height: 1.35; }
.pc-stars { color: #c49a28; font-size: 11px; letter-spacing: 1.5px; margin-bottom: 7px; }
.pc-stars span { font-size: 10.5px; color: var(--pale); margin-left: 4px; }
.pc-price { display: flex; align-items: baseline; gap: 7px; flex-wrap: wrap; }
.p-now { font-family: var(--serif); font-size: 17px; font-weight: 500; color: var(--ink); }
.p-was { font-size: 12px; color: var(--pale); text-decoration: line-through; }
.p-off { font-size: 9.5px; color: var(--danger); font-weight: 700; letter-spacing: .3px; }

/* ── SALE BANNER ── */
.sale-banner { display: grid; grid-template-columns: 52% 48%; min-height: 400px; }
.sb-img { position: relative; overflow: hidden; background: #c8c0b8; min-height: 400px; }
.sb-img img { position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
.sb-body { background: var(--ink); display: flex; flex-direction: column; justify-content: center; padding: 56px 52px; }
.sb-label { font-size: 9.5px; letter-spacing: 4px; text-transform: uppercase; color: rgba(255,255,255,.3); margin-bottom: 14px; }
.sb-h { font-family: var(--serif); font-size: clamp(28px, 3vw, 46px); font-weight: 300; color: #fff; line-height: 1.1; margin-bottom: 16px; }
.sb-h em { font-style: italic; color: rgba(255,255,255,.35); }
.sb-code { display: inline-flex; align-items: center; gap: 12px; background: #1c1c1c; border: 1px solid #282828; padding: 10px 18px; margin-bottom: 24px; width: fit-content; }
.sb-code-l { font-size: 9.5px; letter-spacing: 2px; text-transform: uppercase; color: #3a3a3a; }
.sb-code-v { font-family: var(--serif); font-size: 20px; letter-spacing: 4px; color: rgba(255,255,255,.6); }
.sb-stats { display: grid; grid-template-columns: repeat(2,1fr); gap: 1px; background: #1e1e1e; margin-top: 28px; }
.sb-stat { background: var(--ink); padding: 18px 14px; text-align: center; }
.sb-stat-n { font-family: var(--serif); font-size: 26px; font-weight: 400; color: #fff; line-height: 1; }
.sb-stat-l { font-size: 9px; letter-spacing: 2.5px; text-transform: uppercase; color: #333; margin-top: 5px; }

/* ── TESTIMONIALS ── */
.tgrid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--rule); margin-top: 40px; }
.tc { background: #fff; padding: 36px 30px; transition: background .2s; }
.tc:hover { background: var(--surface); }
.tc-q { font-family: var(--serif); font-size: 56px; line-height: .38; color: var(--rule); margin-bottom: 18px; display: block; }
.tc-stars { color: #c49a28; font-size: 12px; letter-spacing: 3px; margin-bottom: 12px; }
.tc-text { font-family: var(--serif); font-size: 14.5px; font-style: italic; line-height: 1.85; color: var(--body); margin-bottom: 20px; }
.tc-name { font-size: 10.5px; letter-spacing: 2px; text-transform: uppercase; font-weight: 600; color: var(--ink); }
.tc-city { font-size: 11px; color: var(--pale); margin-top: 3px; }

/* ── NEWSLETTER ── */
.newsletter { background: #111; padding: 72px 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
.nl-h { font-family: var(--serif); font-size: clamp(24px, 2.4vw, 38px); font-weight: 400; color: #fff; margin-bottom: 10px; }
.nl-h em { font-style: italic; color: rgba(255,255,255,.3); }
.nl-p { font-size: 13.5px; color: rgba(255,255,255,.3); line-height: 1.85; font-weight: 300; }
.nl-form { display: flex; border: 1px solid #222; overflow: hidden; margin-bottom: 10px; }
.nl-form input { flex: 1; padding: 13px 18px; background: transparent; border: none; outline: none; color: #fff; font-size: 13px; }
.nl-form input::placeholder { color: #2a2a2a; }
.nl-form button { padding: 13px 26px; background: #fff; color: var(--ink); border: none; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; font-weight: 700; cursor: pointer; font-family: var(--sans); transition: background .2s; white-space: nowrap; }
.nl-form button:hover { background: #eee; }
.nl-note { font-size: 11px; color: #242424; }

/* WhatsApp */
.wa { position: fixed; bottom: 28px; right: 28px; z-index: 999; width: 50px; height: 50px; border-radius: 50%; background: #25d366; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 20px rgba(37,211,102,.35); transition: transform .22s; }
.wa:hover { transform: scale(1.08); }
.wa svg { width: 26px; height: 26px; fill: #fff; }

/* ── FOOTER ── */
footer { background: #0c0c0c; padding: 60px 48px 0; border-top: 1px solid #181818; }
.ft { display: grid; grid-template-columns: 1.8fr 1fr 1fr 1fr 1.3fr; gap: 40px; padding-bottom: 44px; border-bottom: 1px solid #181818; }
.ft-logo { font-family: var(--serif); font-size: 20px; font-weight: 500; color: #fff; margin-bottom: 2px; }
.ft-logo em { font-style: italic; font-weight: 400; }
.ft-tagline { font-size: 8px; letter-spacing: 3.5px; text-transform: uppercase; color: #282828; margin-bottom: 14px; }
.ft-about { font-size: 12px; line-height: 1.9; color: #272727; max-width: 220px; margin-bottom: 18px; }
.ft-socs { display: flex; gap: 7px; }
.ft-soc { width: 30px; height: 30px; border: 1px solid #1a1a1a; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: #262626; cursor: pointer; transition: all .18s; }
.ft-soc:hover { border-color: #333; color: #555; }
.ft-col h5 { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: #333; font-weight: 600; margin-bottom: 16px; }
.ft-col ul { display: flex; flex-direction: column; gap: 8px; }
.ft-col a { font-size: 12.5px; color: #222; transition: color .18s; }
.ft-col a:hover { color: #666; }
.ft-ci { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 10px; }
.ft-ci svg { width: 12px; height: 12px; stroke: #333; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; margin-top: 2px; }
.ft-ci p { font-size: 12px; color: #222; line-height: 1.7; }
