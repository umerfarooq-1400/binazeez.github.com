}
.stat-icon.blue{background:#eff6ff}
.stat-icon.green{background:#f0fdf4}
.stat-icon.orange{background:#fff7ed}
.stat-icon.purple{background:#faf5ff}
.stat-num{font-size:22px;font-weight:700;color:#111;line-height:1}
.stat-label{font-size:11.5px;color:#999;margin-top:3px}
.stat-change{font-size:11px;font-weight:600;margin-top:6px}
.up{color:#16a34a}.down{color:#dc2626}

/* ── CARDS ── */
.card{background:#fff;border-radius:10px;border:1px solid #ebebeb;margin-bottom:20px}
.card-hd{
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 22px;border-bottom:1px solid #f5f5f5;
}
.card-title{font-size:14px;font-weight:700;color:#111}
.card-sub{font-size:11.5px;color:#999;margin-top:2px}
.card-body{padding:22px}

/* ── FORM ── */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.form-grid-3{grid-template-columns:1fr 1fr 1fr}
.form-full{grid-column:1/-1}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-label{font-size:11.5px;font-weight:600;color:#444;letter-spacing:.3px}
.form-input{
  padding:9px 13px;border:1.5px solid #e8e8e8;border-radius:6px;
  font-size:13px;color:#111;background:#fff;
  transition:border-color .18s,box-shadow .18s;outline:none;
}
.form-input:focus{border-color:#111;box-shadow:0 0 0 3px rgba(17,17,17,.06)}
.form-input::placeholder{color:#bbb}
textarea.form-input{resize:vertical;min-height:90px}
select.form-input{cursor:pointer}
.form-hint{font-size:11px;color:#aaa}

/* ── TOGGLE ── */
.toggle-row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid #f5f5f5}
.toggle-row:last-child{border:none}
.toggle-info .toggle-title{font-size:13.5px;font-weight:500;color:#111}
.toggle-info .toggle-desc{font-size:11.5px;color:#999;margin-top:2px}
.toggle{position:relative;width:44px;height:24px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0}
.toggle-slider{
  position:absolute;inset:0;background:#ddd;border-radius:24px;
  cursor:pointer;transition:background .2s;
}
.toggle-slider::before{
  content:'';position:absolute;width:18px;height:18px;
  background:#fff;border-radius:50%;bottom:3px;left:3px;
  transition:transform .2s;box-shadow:0 1px 4px rgba(0,0,0,.2);
}
.toggle input:checked+.toggle-slider{background:#111}
.toggle input:checked+.toggle-slider::before{transform:translateX(20px)}

/* ── PRODUCTS TABLE ── */
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}
thead tr{border-bottom:1px solid #f0f0f0}
th{font-size:10.5px;letter-spacing:1.5px;text-transform:uppercase;color:#aaa;font-weight:600;padding:10px 14px;text-align:left}
tbody tr{border-bottom:1px solid #f8f8f8;transition:background .15s}
tbody tr:hover{background:#fafafa}
td{padding:12px 14px;font-size:13px;color:#333;vertical-align:middle}
.td-img{width:44px;height:44px;border-radius:6px;object-fit:cover;border:1px solid #eee;background:#f5f5f5}
.td-name{font-weight:600;color:#111;margin-bottom:2px;font-size:13px}
.td-cat{font-size:10.5px;color:#999;letter-spacing:.5px;text-transform:uppercase}
.td-price{font-weight:700;color:#111;font-size:14px}
.td-was{font-size:11px;color:#ccc;text-decoration:line-through;margin-top:1px}
.badge-tag{display:inline-block;padding:3px 9px;border-radius:20px;font-size:10px;font-weight:600;letter-spacing:.5px;text-transform:uppercase}
.tag-active{background:#f0fdf4;color:#16a34a}
